# The engines field is advisory to pnpm unless this is set — without it, the
# Node range in package.json is a comment that installs happily ignore. With it,
# an install on the wrong major fails immediately and says so.
engine-strict=true

# The lockfile is the record of what was tested. Refusing to silently update it
# during install is what makes a green CI run mean the same thing tomorrow.
prefer-frozen-lockfile=true
