{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
    // No `paths` mapping: workspace packages resolve through their published
    // entry points (package.json main/types) via the pnpm symlinks. Mapping them
    // to source would drag every package's files into each app's program and
    // defeat incremental builds.
  },
  "exclude": ["node_modules", "dist", ".next"]
}
