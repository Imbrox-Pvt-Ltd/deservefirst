{
  "name": "deservefirst-platform",
  "version": "1.0.0",
  "description": "Deservefirst platform monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node server.js",
    "start:ts": "ts-node index.ts",
    "start:nestjs": "ts-node src/main.ts",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "build": "nest build",
    "build:old": "lerna run build",
    "test": "lerna run test",
    "test:nestjs": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "bootstrap": "lerna bootstrap",
    "publish": "lerna publish",
    "validate-modules": "ts-node scripts/validate-modules.ts",
    "cli": "ts-node src/cli/cli.ts",
    "generate-module": "ts-node src/cli/cli.ts generate-module"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/chokidar": "^1.7.5",
    "@types/compression": "^1.8.1",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "ajv": "^8.17.1",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.0",
    "cache-manager-redis-store": "^3.0.1",
    "chokidar": "^4.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "i18next": "^25.5.2",
    "ioredis": "^5.7.0",
    "mysql2": "^3.14.5",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "speakeasy": "^2.0.0",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^4.17.0",
    "@types/node": "^20.19.15",
    "lerna": "^8.0.0",
    "mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
