{
  "name": "deservefirst",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** --filter=./tools/** --filter=./apps/** run build",
    "dev": "pnpm --filter @deservefirst/api run dev",
    "dev:web": "pnpm --filter @deservefirst/web run dev",
    "platform": "node tools/platform-cli/bin/platform.mjs",
    "check": "node tools/platform-cli/bin/platform.mjs check",
    "doctor": "node tools/platform-cli/bin/platform.mjs doctor",
    "test": "node tools/platform-cli/bin/platform.mjs test",
    "ci": "node tools/platform-cli/bin/platform.mjs ci",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "liquidjs": "^10.28.0"
  }
}
